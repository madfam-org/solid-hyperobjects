                "formula": "per_part"
            }
        },
        {
            "id": "kinematic_chain",
            "scad_file": "robot.scad",
            "cq_file": "robot.py",
            "label": {
                "en": "Full Kinematic Chain (SCARA Assembly)",
                "es": "Cadena Cinemática Completa (Ensamblaje SCARA)"
            },
            "description": {
                "en": "Full upper-arm and forearm linkage assembly. Exhibits the defining SCARA morphology: horizontal XY motion fully decoupled from the vertical Z-axis, minimizing gravitational viscosity on the primary movers."
            },
            "parts": [
                "shoulder_link",
                "elbow_link",
                "z_spindle",
                "end_effector_mount"
            ],
            "part_quantities": {
