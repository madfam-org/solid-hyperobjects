  "constraints": [
    {
      "expression": "distal_dia < proximal_dia",
      "severity": "error",
      "message": {
        "en": "Distal diameter must be smaller than proximal (the cup tapers inward)",
        "es": "El diámetro distal debe ser menor que el proximal (la copa se estrecha)"
      }
    },
    {
      "expression": "bolt_circle_dia + 10 <= adapter_plate_dia",
      "severity": "warning",
      "message": {
        "en": "Bolt circle is large relative to the adapter plate",
        "es": "El círculo de pernos es grande respecto a la placa del adaptador"
      }
    }
  ],
