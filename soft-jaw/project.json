  "constraints": [
    {
      "expression": "jaw_thickness >= 0.5",
      "severity": "error",
      "message": {
        "en": "Jaw must be at least 0.5 inch thick to carry the bolt counterbores",
        "es": "La mordaza debe tener al menos 0.5 pulg de grosor para alojar los avellanados"
      }
    },
    {
      "expression": "workpiece_dia / 2 < jaw_thickness * 25.4 - 3",
      "severity": "error",
      "message": {
        "en": "Round stock radius must be smaller than the jaw thickness less a back wall — a larger trough would cut through the back of the jaw",
        "es": "El radio de la pieza redonda debe ser menor que el grosor de la mordaza menos una pared trasera — una canal mayor atravesaría la parte posterior de la mordaza"
      }
    },
    {
      "expression": "pocket_depth < jaw_thickness * 25.4",
      "severity": "warning",
      "message": {
        "en": "Pocket depth is large relative to jaw thickness",
        "es": "La profundidad de la cajera es grande respecto al grosor de la mordaza"
      }
    }
  ],
