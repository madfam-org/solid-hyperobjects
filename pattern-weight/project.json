    },
    "engine": "cadquery",
    "description": {
      "en": "A 3D-printed stackable tailor's pattern weight — the wide, low disc that pins a paper pattern to cloth without a single pin hole, so slippery silks and knits get cut on the true grain. Finger recess for one-handed lifting, stacking registration for storage.\n\nOfficial Visualizer and Configurator: Yantra4D",
      "es": "Un pisapatrones de sastre apilable impreso en 3D — el disco ancho y bajo que fija el patrón de papel a la tela sin un solo alfilerazo, para cortar sedas y puntos al hilo verdadero. Rebaje para el dedo y registro de apilado.\n\nVisualizador y configurador oficial: Yantra4D"
    },
    "thumbnail": "/projects/pattern-weight.webp",
    "difficulty": "beginner",
    "tags": [
      "pattern-weight",
      "sewing",
      "atelier",
      "cutting",
      "tool",
      "notion",
      "wearable",
      "hyperobject",
      "commons"
    ],
    "hyperobject": {
      "is_hyperobject": true
    },
    "force_backend": true
  },
