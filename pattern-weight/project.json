      "id": "body",
      "label": {
        "en": "Body",
        "es": "Cuerpo"
      }
    },
    {
      "id": "stacking",
      "label": {
        "en": "Stacking",
        "es": "Apilado"
      }
    }
  ],
  "parameters": [
    {
      "id": "weight_dia",
      "type": "slider",
      "default": 62.0,
      "min": 30.0,
      "max": 120.0,
      "step": 1.0,
      "group": "body",
      "modes": [
        "weight",
        "stack",
        "set"
      ],
      "label": {
        "en": "Outside diameter (mm)",
        "es": "Diámetro exterior (mm)"
      },
      "tooltip": {
        "en": "Outside diameter (mm)",
        "es": "Diámetro exterior (mm)"
      }
    },
    {
      "id": "weight_h",
      "type": "slider",
      "default": 16.0,
      "min": 8.0,
      "max": 40.0,
      "step": 0.5,
      "group": "body",
      "modes": [
        "weight",
        "stack",
        "set"
      ],
      "label": {
        "en": "Body height (mm)",
        "es": "Altura del cuerpo (mm)"
      },
      "tooltip": {
        "en": "Body height (mm)",
        "es": "Altura del cuerpo (mm)"
      }
    },
    {
      "id": "rim_chamfer",
      "type": "slider",
      "default": 2.0,
      "min": 0.0,
      "max": 6.0,
      "step": 0.2,
      "group": "body",
      "modes": [
        "weight",
        "stack",
        "set"
      ],
      "label": {
        "en": "Rim chamfer (mm)",
        "es": "Chaflán del borde (mm)"
      },
      "tooltip": {
        "en": "Rim chamfer (mm)",
        "es": "Chaflán del borde (mm)"
      }
    },
    {
      "id": "recess_dia",
      "type": "slider",
      "default": 26.0,
      "min": 10.0,
      "max": 80.0,
      "step": 1.0,
      "group": "body",
      "modes": [
        "weight",
        "stack",
        "set"
      ],
      "label": {
        "en": "Finger recess diameter (mm)",
        "es": "Diámetro del rebaje (mm)"
      },
      "tooltip": {
        "en": "Finger recess diameter (mm)",
        "es": "Diámetro del rebaje (mm)"
      }
    },
    {
      "id": "recess_d",
      "type": "slider",
      "default": 5.0,
      "min": 1.0,
      "max": 14.0,
      "step": 0.2,
      "group": "body",
      "modes": [
        "weight",
        "stack",
        "set"
      ],
      "label": {
        "en": "Finger recess depth (mm)",
        "es": "Profundidad del rebaje (mm)"
      },
      "tooltip": {
        "en": "Finger recess depth (mm)",
        "es": "Profundidad del rebaje (mm)"
      }
    },
    {
      "id": "boss_h",
      "type": "slider",
      "default": 2.4,
      "min": 0.0,
      "max": 8.0,
      "step": 0.2,
      "group": "stacking",
      "modes": [
        "weight",
        "stack",
        "set"
      ],
      "label": {
        "en": "Stacking boss height (mm)",
        "es": "Altura del resalte de apilado (mm)"
      },
      "tooltip": {
        "en": "Stacking boss height (mm)",
        "es": "Altura del resalte de apilado (mm)"
      }
    },
    {
      "id": "stack_clear",
      "type": "slider",
      "default": 0.3,
      "min": 0.1,
      "max": 1.0,
      "step": 0.05,
      "group": "stacking",
      "modes": [
        "weight",
        "stack",
        "set"
      ],
      "label": {
        "en": "Stacking clearance (mm)",
        "es": "Holgura de apilado (mm)"
      },
      "tooltip": {
        "en": "Stacking clearance (mm)",
        "es": "Holgura de apilado (mm)"
      }
    }
  ],
  "presets": [
    {
      "id": "default",
      "mode": "weight",
      "label": {
        "en": "Default",
        "es": "Predeterminado"
      },
      "values": {
        "weight_dia": 62.0
      }
    }
  ],
  "constraints": [
    {
      "expression": "recess_dia + 12.0 <= weight_dia",
      "severity": "error",
      "message": {
        "en": "The finger recess reaches the rim: recess_dia must be at least 12 mm smaller than weight_dia.",
        "es": "El rebaje para el dedo alcanza el borde: recess_dia debe ser al menos 12 mm menor que weight_dia."
      }
    },
    {
      "expression": "recess_d <= weight_h / 2.5",
      "severity": "error",
      "message": {
        "en": "recess_d exceeds weight_h/2.5; the finger recess punches through the weight and leaves no mass.",
        "es": "recess_d supera weight_h/2.5; el rebaje atraviesa el peso y no deja masa."
      }
    },
    {
      "expression": "boss_h <= weight_h / 4.0",
      "severity": "error",
      "message": {
        "en": "boss_h exceeds weight_h/4; the stacking moat and the underside socket meet and sever the body.",
        "es": "boss_h supera weight_h/4; el foso de apilado y el zócalo inferior se encuentran y cortan el cuerpo."
      }
    },
    {
      "expression": "rim_chamfer <= weight_h / 3.0",
      "severity": "error",
      "message": {
        "en": "rim_chamfer exceeds weight_h/3; the top and bottom chamfers meet and the rim goes to a knife edge.",
        "es": "rim_chamfer supera weight_h/3; los chaflanes superior e inferior se juntan y el borde queda en filo."
      }
    },
    {
      "expression": "recess_dia + 8.0 + 2.0 * boss_h + 2.0 * stack_clear <= weight_dia",
      "severity": "warning",
      "message": {
        "en": "The stacking boss (recess_dia + 8 mm) plus boss_h and stack_clear leaves no land inside weight_dia; weights will not register when stacked.",
        "es": "El buje de apilado (recess_dia + 8 mm) más boss_h y stack_clear no deja meseta dentro de weight_dia; los pesos no registrarán al apilarse."
      }
    }
  ],
  "camera_views": [
    {
      "id": "iso",
      "label": {
        "en": "Isometric",
        "es": "Isométrico"
      },
      "position": [
        90,
        90,
        70
      ]
    }
  ],
  "export_formats": [
    "stl",
    "3mf",
    "step",
    "glb",
    "gltf",
    "obj"
  ],
  "estimate_constants": {
    "base_time": 12,
    "per_unit": 2,
    "per_part": 8,
    "fn_factor": 16,
    "wasm_multiplier": 4,
    "warning_threshold_seconds": 90
  },
  "hyperobject": {
    "domain": "wearable",
    "cdg_interfaces": [
      {
        "id": "stack_register",
        "label": {
          "en": "Stacking Register",
          "es": "Registro de apilado"
        },
        "geometry_type": "socket",
        "standard": "internal",
        "parameters": [
          "weight_dia",
          "boss_h",
          "stack_clear"
        ]
      },
      {
        "id": "table_face",
        "label": {
          "en": "Table Face",
          "es": "Cara de mesa"
        },
        "geometry_type": "surface",
        "standard": "internal",
        "parameters": [
          "weight_dia",
          "rim_chamfer"
        ]
      }
    ],
    "material_awareness": {
      "shrinkage_compensation": false,
      "recycled_material_toggle": true,
      "tolerance_by_material": true
    },
    "societal_benefit": {
      "en": "Pattern weights replace pins: no pin holes in cloth that shows them, no distortion of the grain, and a faster cut. Bought, they are a per-dozen cost that keeps home and small-shop cutters using pins; printed, a full set costs filament and an afternoon.",
      "es": "Los pisapatrones sustituyen a los alfileres: sin agujeros en telas que los delatan, sin deformar el hilo y con un corte más rápido. Comprados, su costo por docena mantiene a talleres pequeños usando alfileres; impresos, un juego cuesta filamento y una tarde."
    },
    "commons_license": "CERN-OHL-W-2.0"
  },
  "tags": [
    "pattern-weight",
    "sewing",
    "atelier",
    "cutting",
    "tool",
    "notion",
    "wearable",
    "hyperobject",
    "commons"
  ],
  "verification": {
    "stages": {
      "geometry": {
        "checks": {
          "watertight": { "enabled": true },
          "body_count": { "enabled": true, "expected": 1 }
        }
      }
    },
    "mode_overrides": {
      "set": {
        "part_overrides": {
          "set": { "geometry.body_count": { "expected": 4 } }
        }
      },
      "stack": {
        "part_overrides": {
          "stack": { "geometry.body_count": { "expected": 2 } }
        }
      }
    }
  }
}
