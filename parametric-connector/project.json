  "constraints": [
    {
      "expression": "wall >= 2",
      "severity": "error",
      "message": {
        "en": "Wall must be at least 2 mm for a printable socket",
        "es": "La pared debe ser de al menos 2 mm para un enchufe imprimible"
      }
    },
    {
      "expression": "clearance < wall",
      "severity": "warning",
      "message": {
        "en": "Clearance approaching wall thickness — the socket wall may be too thin",
        "es": "La holgura se acerca al grosor de pared — la pared del enchufe puede quedar muy delgada"
      }
    }
  ],
