  "parameters": [
    {
      "id": "pipe_od",
      "type": "slider",
      "default": 21.3,
      "min": 6,
      "max": 60,
      "step": 0.1,
      "group": "material",
      "modes": [
        "elbow",
        "tee",
        "corner_3way"
      ],
      "label": {
        "en": "Measured Pipe OD (mm)",
        "es": "OD Medido del Tubo (mm)"
      },
      "tooltip": {
        "en": "Outer diameter of your local material — measure the actual PVC, bamboo, or dowel with calipers.",
        "es": "Diámetro exterior de tu material local — mide el PVC, bambú o espiga real con calibrador."
      },
      "preview_hint": {
        "type": "axis_scale",
        "axis": "radial",
        "scale_factor": 1.0
      }
    },
    {
      "id": "wall",
      "type": "slider",
      "default": 3.0,
      "min": 2.0,
      "max": 8.0,
      "step": 0.5,
      "group": "socket",
      "modes": [
        "elbow",
        "tee",
        "corner_3way"
      ],
      "label": {
        "en": "Wall Thickness (mm)",
        "es": "Grosor de Pared (mm)"
      },
      "tooltip": {
        "en": "Socket wall thickness around the pipe. Thicker = stronger joint.",
        "es": "Grosor de la pared del enchufe alrededor del tubo. Más grueso = unión más fuerte."
      }
    },
    {
      "id": "insertion_depth",
      "type": "slider",
      "default": 20.0,
      "min": 10.0,
      "max": 50.0,
      "step": 1.0,
      "group": "socket",
      "modes": [
        "elbow",
        "tee",
        "corner_3way"
      ],
      "label": {
        "en": "Insertion Depth (mm)",
        "es": "Profundidad de Inserción (mm)"
      },
      "tooltip": {
        "en": "How deep each pipe seats into its socket. Deeper = more surface for a rigid, glued, or friction joint.",
        "es": "Qué tan profundo asienta cada tubo en su enchufe. Más profundo = más superficie para una unión rígida, pegada o por fricción."
      }
    },
    {
      "id": "clearance",
      "type": "slider",
      "default": 0.5,
      "min": 0.1,
      "max": 2.0,
      "step": 0.05,
      "group": "socket",
      "modes": [
        "elbow",
        "tee",
        "corner_3way"
      ],
      "advanced": true,
      "label": {
        "en": "Bore Clearance (mm)",
        "es": "Holgura del Barreno (mm)"
      },
      "tooltip": {
        "en": "Extra diameter over the measured OD for a slip fit. Raise for rough/irregular stock like bamboo; lower for a tight PVC fit.",
        "es": "Diámetro adicional sobre el OD medido para un ajuste deslizante. Súbelo para material rugoso/irregular como bambú; bájalo para un ajuste apretado de PVC."
      }
    },
    {
      "id": "elbow_angle",
      "type": "slider",
      "default": 90.0,
      "min": 20.0,
      "max": 160.0,
      "step": 1.0,
      "group": "topology",
      "modes": [
        "elbow"
      ],
      "label": {
        "en": "Elbow Angle (°)",
        "es": "Ángulo del Codo (°)"
      },
      "tooltip": {
        "en": "Angle between the two arms. 90° is a right-angle elbow; open it up for the shallow struts of a geodesic dome or a splayed leg.",
        "es": "Ángulo entre los dos brazos. 90° es un codo recto; ábrelo para los puntales poco profundos de un domo geodésico o una pata abierta."
      }
    },
    {
      "id": "heavy_load",
      "type": "checkbox",
      "default": false,
      "group": "load",
      "modes": [
        "elbow",
        "tee",
        "corner_3way"
      ],
      "label": {
        "en": "Heavy Load",
        "es": "Carga Pesada"
      },
      "tooltip": {
        "en": "Thicker walls plus three internal gusset ribs per socket, for load-bearing shelter frames.",
        "es": "Paredes más gruesas más tres nervaduras internas por enchufe, para estructuras de refugio que soportan carga."
      }
    },
    {
      "id": "pin_holes",
      "type": "checkbox",
      "default": false,
      "group": "load",
      "modes": [
        "elbow",
        "tee",
        "corner_3way"
      ],
      "label": {
        "en": "Pin/Screw Holes",
        "es": "Orificios de Pasador/Tornillo"
      },
      "tooltip": {
        "en": "Add a cross through-hole near each socket mouth to fix the seated pipe with a pin or self-tapping screw.",
        "es": "Agrega un orificio pasante cruzado cerca de la boca de cada enchufe para fijar el tubo asentado con un pasador o tornillo autorroscante."
      }
    },
    {
      "id": "pin_dia",
      "type": "slider",
      "default": 4.0,
      "min": 2.0,
      "max": 8.0,
      "step": 0.5,
      "group": "load",
      "modes": [
        "elbow",
        "tee",
        "corner_3way"
      ],
      "advanced": true,
      "label": {
        "en": "Pin Diameter (mm)",
        "es": "Diámetro del Pasador (mm)"
      },
      "tooltip": {
        "en": "Shank diameter of the fixing pin or screw (only used when Pin/Screw Holes is on).",
        "es": "Diámetro del vástago del pasador o tornillo de fijación (solo se usa cuando Orificios de Pasador/Tornillo está activo)."
      }
    },
    {
      "id": "pipe_od_mm",
      "type": "slider",
      "default": 21.3,
      "min": 10,
      "max": 60,
      "step": 0.1,
      "label": {
        "en": "Pipe OD (mm)",
        "es": "OD Tubería (mm)"
      },
      "tooltip": {
        "en": "Outer diameter of the pipe/dowel",
