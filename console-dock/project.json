  "verification": {
    "stages": {
      "geometry": {
        "checks": {
          "body_count": {
            "expected": 1
          }
        }
      }
    },
    "mode_overrides": {
      "dock": {
        "part_overrides": {
          "dock": {
            "geometry.body_count": {
              "expected": "2 if rear_door_present else 1"
            }
          }
        }
      }
    }
  },
  "constraints": [
    {
      "expression": "base_height + wall < body_height",
      "severity": "error",
      "message": {
        "en": "Base must leave a usable cradle.",
        "es": "La base debe dejar espacio de asiento."
      }
    },
    {
      "expression": "wall * 4 < body_width && wall * 4 < body_depth",
      "severity": "error",
      "message": {
        "en": "Walls must fit the body.",
        "es": "Las paredes deben caber en el cuerpo."
      }
    },
    {
      "expression": "seat_depth + clearance * 2 < body_depth",
      "severity": "error",
      "message": {
        "en": "Seat must fit the depth.",
        "es": "El asiento debe caber en el fondo."
      }
    }
  ],
  "animations": [
    {
      "id": "rear-door-open",
      "label": {
        "en": "Open service cover",
        "es": "Abrir tapa de servicio"
      },
      "from_state": {
        "rear_door_present": true,
        "door_angle": 0
      },
      "to_state": {
        "rear_door_present": true,
        "door_angle": 90
      },
      "frames": 5,
      "duration_ms": 2000,
