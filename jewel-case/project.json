  "constraints": [
    {
      "expression": "case_width > disc_diameter + wall * 4 && case_height > disc_diameter + wall * 4",
      "severity": "error",
      "message": {
        "en": "The disc and tray must fit the case.",
        "es": "El disco y la bandeja deben caber en la caja."
      }
    },
    {
      "expression": "case_thickness > wall * 4 + hub_height",
      "severity": "error",
      "message": {
        "en": "The case must clear the disc hub.",
        "es": "La caja debe dejar espacio para la retención."
      }
    },
    {
      "expression": "hub_diameter < disc_diameter / 2 && hub_diameter > 4",
      "severity": "error",
      "message": {
        "en": "The hub must fit the medium.",
        "es": "La retención debe caber en el medio."
      }
    }
  ],
