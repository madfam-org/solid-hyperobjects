        "es": "Cubo",
        "en": "Cube"
      },
      "parts": [
        "cubies",
        "core",
        "stickers",
        "frame"
      ],
      "part_quantities": {
        "cubies": "N * N * N - (N - 2) * (N - 2) * (N - 2)",
        "core": 1,
        "stickers": "6 * N * N",
        "frame": 1
      },
      "estimate": {
        "base_units": "N * N",
        "formula": "grid",
        "formula_vars": [
          "N"
        ]
      }
    },
    {
      "id": "sphere",
