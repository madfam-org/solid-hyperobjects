{
  "project": {
    "name": "Parametric Rubik's Cube",
    "slug": "rubiks-hyperobject",
    "version": "1.0.0",
    "description": "Parametric Rubik's Cube hyperobject — NxN cube with layer rotation, exploded view, and spherical variant\n\nOfficial Visualizer and Configurator: Yantra4D",
    "thumbnail": "/projects/rubiks-hyperobject.webp",
    "tags": [
      "puzzle",
      "rubiks",
      "cube",
      "parametric",
      "toy",
      "educational",
      "mechanical",
      "hyperobject",
      "commons",
      "cdg",
      "bosl2"
    ],
    "difficulty": "intermediate",
    "welcome": {
      "enabled": true,
      "heading": {
        "es": "Cubo de Rubik Parametrico",
        "en": "Parametric Rubik's Cube"
      },
      "body": {
        "es": "Un cubo de Rubik completamente parametrico: elige el tamano de cuadricula (2x2 a 9x9), rota capas individuales (incluidas capas medias) y explora la vista explosionada.",
        "en": "A fully parametric Rubik's Cube: choose grid size (2x2 to 9x9), rotate individual layers (including middle layers), and explore the exploded assembly view."
      },
      "features": [
        {
          "icon": "grid_view",
          "text": {
            "es": "Escala de 2x2 (Pocket) a 9x9 con un solo control",
            "en": "Scale from 2x2 (Pocket) to 9x9 with a single slider"
          }
        },
        {
          "icon": "rotate_right",
          "text": {
            "es": "Rota las 6 capas individuales para visualizar estados del puzzle",
            "en": "Rotate all 6 individual layers to visualize puzzle states"
          }
        },
        {
          "icon": "open_in_full",
          "text": {
            "es": "Vista explosionada para ver el mecanismo interno del cubo",
            "en": "Exploded view to see the internal core mechanism"
          }
        }
      ],
      "cta_label": {
        "es": "Comenzar",
        "en": "Get Started"
      }
    },
    "guest_render_limit": 100,
    "force_backend": true
  },
  "hyperobject": {
    "domain": "hybrid",
    "cdg_interfaces": [
      {
        "id": "cubie_socket",
        "label": {
          "es": "Cavidad de Cubie",
          "en": "Cubie Socket"
        },
        "geometry_type": "pocket",
        "standard": "internal",
        "parameters": [
          "N",
          "size",
          "clearance",
          "corner_rounding",
          "insert_pocket_depth",
          "insert_pin_dia"
        ]
      },
      {
        "id": "display_stand_mount",
        "label": {
          "es": "Montaje para Base de Exhibicion",
          "en": "Display Stand Mount"
        },
        "geometry_type": "socket",
        "standard": "internal",
        "parameters": [
          "size"
        ]
      },
      {
        "id": "core_mechanism",
        "label": {
          "es": "Mecanismo Central",
          "en": "Core Mechanism"
        },
        "geometry_type": "rail",
        "standard": "internal",
        "parameters": [
          "N",
          "size",
          "mechanism_detail",
          "spring_dia",
          "spring_length",
          "screw_dia",
          "mechanism_clearance"
        ]
      }
    ],
    "material_awareness": {
      "shrinkage_compensation": false,
      "recycled_material_toggle": false,
      "tolerance_by_material": true
    },
    "societal_benefit": {
      "es": "Permite a educadores, makers y entusiastas de puzzles fabricar cubos de Rubik parametricos personalizados — desde prototipos didacticos hasta rompecabezas de exhibicion — independiente de cadenas de suministro comerciales.",
      "en": "Enables educators, makers, and puzzle enthusiasts to fabricate custom parametric Rubik's cubes — from didactic prototypes to exhibition puzzles — independent of commercial supply chains."
    },
    "commons_license": "CERN-OHL-W-2.0"
  },
