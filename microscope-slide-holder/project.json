  "parameters": [
    {
      "id": "slide_standard",
      "type": "select",
      "default": 1,
      "group": "slide",
      "modes": [
        "slide_box",
        "slide_tray",
        "staining_rack_cq"
      ],
      "label": {
        "en": "Slide Standard",
        "es": "Estándar de Laminilla"
      },
      "tooltip": {
        "en": "Standard slide envelope. The CDG default is US 3\"x1\" (76.2 x 25.4 mm).",
        "es": "Envolvente estándar de laminilla. El CDG por defecto es US 3\"x1\" (76.2 x 25.4 mm)."
      },
      "options": [
        {
          "value": 0,
          "label": {
            "en": "ISO 8037 (76 x 26)",
            "es": "ISO 8037 (76 x 26)"
          }
        },
        {
          "value": 1,
          "label": {
            "en": "US 3\"x1\" (76.2 x 25.4)",
            "es": "US 3\"x1\" (76.2 x 25.4)"
          }
        },
        {
          "value": 2,
          "label": {
            "en": "Petrographic (46 x 27)",
            "es": "Petrográfico (46 x 27)"
          }
        },
        {
          "value": 3,
          "label": {
            "en": "Supa Mega (75 x 50)",
            "es": "Supa Mega (75 x 50)"
          }
        },
        {
          "value": 4,
          "label": {
            "en": "Custom",
            "es": "Personalizado"
          }
        }
