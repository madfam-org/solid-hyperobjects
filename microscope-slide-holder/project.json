{
  "project": {
    "name": "Microscope Slide Holder",
    "slug": "microscope-slide-holder",
    "version": "3.1.0",
    "attribution": {
      "author": "Innovaciones MADFAM",
      "license": "CERN-OHL-W-2.0"
    },
    "engine": "cadquery",
    "description": {
      "en": "Parametric microscope slide retention system (B-Rep / CadQuery) — a covered slotted storage box with lid, a flat multi-pocket tray, and an open staining rack that holds slides on edge for reagent dipping. Built around the standard 25.4 x 76.2 mm (1\" x 3\") slide pocket per ISO 8037-1.\n\nOfficial Visualizer and Configurator: Yantra4D",
      "es": "Sistema paramétrico de retención de portaobjetos de microscopio (B-Rep / CadQuery) — una caja de almacenamiento ranurada con tapa, una bandeja plana multi-bolsillo y un bastidor de tinción abierto que sostiene las laminillas de canto para inmersión en reactivo. Construido en torno al bolsillo estándar de 25.4 x 76.2 mm (1\" x 3\") según ISO 8037-1.\n\nVisualizador y configurador oficial: Yantra4D"
    },
    "thumbnail": "/projects/microscope-slide-holder.webp",
    "difficulty": "intermediate",
    "tags": [
      "lab",
      "microscope",
      "science",
      "organizer",
      "rack",
      "histology",
      "pathology",
      "archival",
      "medical",
      "hyperobject",
      "commons",
      "cdg",
      "bosl2",
      "pilot"
    ],
    "hyperobject": {
      "is_hyperobject": true
    },
    "force_backend": true
  },
