  "constraints": [
    {
      "expression": "drum_d - bore >= 8",
      "severity": "error",
      "message": {
        "en": "The drum needs at least 4 mm of wall around the bore",
        "es": "El tambor necesita al menos 4 mm de pared alrededor del barreno"
      }
    },
    {
      "expression": "flange_h >= cable_d + 3",
      "severity": "error",
      "message": {
        "en": "The flanges must stand a cable diameter plus 3 mm above the drum, so the cable is retained and the anchor hole keeps its walls",
        "es": "Las bridas deben sobresalir del tambor un diámetro de cable más 3 mm, para retener el cable y conservar las paredes del barreno de anclaje"
      }
    },
    {
      "expression": "key_w < bore",
      "severity": "error",
      "message": {
        "en": "The key must be narrower than the shaft",
        "es": "La cuña debe ser más angosta que el eje"
      }
    },
    {
      "expression": "hub_d - bore >= 6",
      "severity": "error",
      "message": {
        "en": "The hub needs at least 3 mm of wall around the bore",
        "es": "El cubo necesita al menos 3 mm de pared alrededor del barreno"
      }
    },
    {
      "expression": "hub_d <= drum_d + 2 * flange_h",
      "severity": "error",
      "message": {
        "en": "The hub cannot be wider than the flange",
        "es": "El cubo no puede ser más ancho que la brida"
      }
    },
    {
      "expression": "setscrew_dia < hub_l - 2",
      "severity": "error",
      "message": {
        "en": "The set-screw hole must fit inside the hub length",
        "es": "El barreno del prisionero debe caber en el largo del cubo"
      }
    },
    {
      "expression": "drum_d >= 8 * cable_d",
      "severity": "warning",
      "message": {
        "en": "A drum under 8 cable diameters bends the cable hard; check the cable maker's minimum",
        "es": "Un tambor menor a 8 diámetros de cable lo dobla demasiado; revisa el mínimo del fabricante del cable"
      }
    }
  ],
