  "constraints": [
    {
      "expression": "spacing >= post_w + 2 * rail_margin + 20",
      "severity": "error",
      "message": {
        "en": "The posts are too close: the rails need at least 20 mm of window between them",
        "es": "Los postes están demasiado juntos: los largueros necesitan al menos 20 mm de ventana entre ellos"
      }
    },
    {
      "expression": "rear_d + front_d + 20 <= base_depth",
      "severity": "error",
      "message": {
        "en": "The rear and front members must leave at least 20 mm of window between them",
        "es": "Los miembros trasero y delantero deben dejar al menos 20 mm de ventana entre ellos"
      }
    },
    {
      "expression": "post_y - post_d / 2 >= 2 * foot_bolt_d + 14",
      "severity": "error",
      "message": {
        "en": "The post stands too close to the rear edge: its socket would meet the foot hole",
        "es": "El poste queda demasiado cerca del borde trasero: su alojamiento tocaría el barreno de la pata"
      }
    },
    {
      "expression": "base_depth - post_y - post_d / 2 >= 2 * foot_bolt_d + 14",
      "severity": "error",
      "message": {
        "en": "The post stands too close to the front edge: its socket would meet the foot hole",
        "es": "El poste queda demasiado cerca del borde delantero: su alojamiento tocaría el barreno de la pata"
      }
    },
    {
      "expression": "socket_depth + 5 <= rail_h",
      "severity": "error",
      "message": {
        "en": "The socket must leave at least 5 mm of floor under the post",
        "es": "El alojamiento debe dejar al menos 5 mm de piso bajo el poste"
      }
    },
    {
      "expression": "cap_depth + 5 <= bar_h",
      "severity": "error",
      "message": {
        "en": "The cap must leave at least 5 mm of crossbar above the post",
        "es": "La tapa debe dejar al menos 5 mm de travesaño sobre el poste"
      }
    },
    {
      "expression": "cap_depth == 0 || bar_margin >= 3",
      "severity": "error",
      "message": {
        "en": "A cap needs at least 3 mm of wall round the post: widen the margin or set the cap depth to 0",
        "es": "Una tapa necesita al menos 3 mm de pared alrededor del poste: amplía el margen o pon la profundidad de la tapa en 0"
      }
    },
    {
      "expression": "arm_bolt_span + arm_hole_d + 6 <= spacing - post_w - 2 * fit",
      "severity": "error",
      "message": {
        "en": "The arm holes must stay between the two posts, at least 3 mm clear of each",
        "es": "Los barrenos del brazo deben quedar entre los dos postes, al menos a 3 mm de cada uno"
      }
    },
    {
      "expression": "arm_mount_drop >= arm_hole_d / 2 + 3 && arm_mount_drop + arm_hole_d / 2 + 3 <= bar_h",
      "severity": "error",
      "message": {
        "en": "The arm holes must sit inside the height of the crossbar, with 3 mm above and below",
        "es": "Los barrenos del brazo deben quedar dentro de la altura del travesaño, con 3 mm arriba y abajo"
      }
    },
    {
      "expression": "socket_depth >= 8",
      "severity": "warning",
      "message": {
        "en": "A socket under 8 mm locates the post but barely braces it: rely on the bolt",
        "es": "Un alojamiento de menos de 8 mm ubica el poste pero apenas lo arriostra: depende del tornillo"
      }
    },
    {
      "expression": "post_y * 5 >= base_depth && (base_depth - post_y) * 5 >= base_depth",
      "severity": "warning",
      "message": {
        "en": "The posts stand within a fifth of the depth from an edge: a load hung on that side can tip the base",
        "es": "Los postes quedan a menos de un quinto del fondo de un borde: una carga colgada de ese lado puede volcar la base"
      }
    },
    {
      "expression": "ledge_h + 5 <= rail_h",
      "severity": "error",
      "message": {
        "en": "The ledge must stay at least 5 mm below the top of the rails, or it is not a ledge",
        "es": "La repisa debe quedar al menos 5 mm bajo la cara superior de los largueros, o deja de ser repisa"
      }
    },
    {
      "expression": "ledge_seat_y >= ledge_hole_d / 2 + 3 && ledge_seat_y + ledge_hole_d / 2 + 3 <= ledge_d",
      "severity": "error",
      "message": {
        "en": "The seat holes must sit on the ledge with 3 mm of material to each edge",
        "es": "Los barrenos de los asientos deben quedar sobre la repisa con 3 mm de material a cada borde"
      }
    },
    {
      "expression": "ledge_seat_span + ledge_seat_pitch + ledge_hole_d + 6 <= spacing + post_w + 2 * rail_margin",
      "severity": "error",
      "message": {
        "en": "The two ledge seats must fit within the width of the base",
        "es": "Los dos asientos de la repisa deben caber en el ancho de la base"
      }
    },
    {
      "expression": "ledge_seat_span >= ledge_seat_pitch + ledge_hole_d + 6",
      "severity": "error",
      "message": {
        "en": "The two ledge seats overlap",
        "es": "Los dos asientos de la repisa se enciman"
      }
    },
    {
      "expression": "!rear_seats || rear_seat_py + rear_hole_d + 6 <= rear_d",
      "severity": "error",
      "message": {
        "en": "The rear seat pattern is deeper than the rear member",
        "es": "El patrón del asiento trasero es más profundo que el miembro trasero"
      }
    },
    {
      "expression": "!rear_seats || 2 * rear_seat_x + rear_seat_px + rear_hole_d + 6 <= spacing - post_w - 2 * rail_margin",
      "severity": "error",
      "message": {
        "en": "The rear seats must stay between the rails, clear of the post sockets and the foot holes",
        "es": "Los asientos traseros deben quedar entre los largueros, libres de los alojamientos de poste y de los barrenos de patas"
      }
    },
    {
      "expression": "!rear_seats || rear_seat_x == 0 || 2 * rear_seat_x >= rear_seat_px + rear_hole_d + 6",
      "severity": "error",
      "message": {
        "en": "The two rear seats overlap",
        "es": "Los dos asientos traseros se enciman"
      }
    }
  ],
