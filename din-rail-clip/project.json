    },
    {
      "expression": "spring_thickness <= plate_thickness",
      "severity": "warning",
      "message": {
        "en": "A spring beam thicker than the plate stops flexing — reduce it for a working snap.",
        "es": "Una viga de resorte más gruesa que la placa deja de flexionar — redúzcala para un encaje funcional."
      }
    }
