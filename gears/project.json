        "helical",
        "ring",
        "rack"
      ],
      "label": {
        "en": "Module (mm)",
        "es": "Módulo (mm)"
      },
      "tooltip": {
        "en": "Tooth size. Pitch diameter = module × teeth. Two gears mesh only if their modules match.",
        "es": "Tamaño del diente. Diámetro primitivo = módulo × dientes. Dos engranajes engranan solo si sus módulos coinciden."
      },
      "preview_hint": {
        "type": "axis_scale",
        "axis": "radial",
        "scale_factor": 1.0
      }
    },
    {
      "id": "teeth",
      "type": "slider",
      "default": 20,
      "min": 6,
      "max": 120,
      "step": 1,
      "group": "tooth",
      "modes": [
        "spur",
        "helical",
        "ring"
      ],
      "label": {
        "en": "Teeth Count",
        "es": "Número de Dientes"
      },
      "tooltip": {
        "en": "Number of teeth. Gear ratio between two gears is the ratio of their tooth counts.",
        "es": "Número de dientes. La relación de transmisión entre dos engranajes es la razón de sus números de dientes."
      },
      "preview_hint": {
        "type": "axis_scale",
        "axis": "radial",
        "scale_factor": 1.0
      }
    },
    {
      "id": "pressure_angle",
      "type": "select",
      "default": 20,
      "group": "tooth",
      "modes": [
        "spur",
        "helical",
        "ring",
        "rack"
      ],
      "advanced": true,
      "label": {
        "en": "Pressure Angle (°)",
        "es": "Ángulo de Presión (°)"
      },
      "tooltip": {
        "en": "Involute flank angle. 20° is the modern standard (ISO 53); 14.5° for legacy stock; 25° for high load. Must match on both gears.",
        "es": "Ángulo del flanco involuto. 20° es el estándar moderno (ISO 53); 14.5° para piezas antiguas; 25° para alta carga. Debe coincidir en ambos engranajes."
      },
      "options": [
        {
          "value": 14.5,
          "label": {
            "en": "14.5° (legacy)",
            "es": "14.5° (antiguo)"
          }
        },
        {
          "value": 20,
          "label": {
            "en": "20° (standard)",
            "es": "20° (estándar)"
          }
        },
        {
          "value": 25,
          "label": {
            "en": "25° (high load)",
            "es": "25° (alta carga)"
          }
        }
      ]
    },
    {
      "id": "helix",
      "type": "slider",
      "default": 0,
      "min": 0,
      "max": 45,
      "step": 1,
      "group": "tooth",
      "modes": [
        "spur",
        "helical",
        "ring"
      ],
      "label": {
        "en": "Helix Angle (°)",
        "es": "Ángulo Helicoidal (°)"
      },
      "tooltip": {
        "en": "Twist of the teeth along the face width. 0 = spur. Helical gears run quieter and carry more load but produce axial thrust.",
        "es": "Torsión de los dientes a lo largo del ancho de cara. 0 = recto. Los helicoidales son más silenciosos y soportan más carga pero generan empuje axial."
