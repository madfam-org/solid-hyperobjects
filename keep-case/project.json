  "verification": {
    "stages": {
      "geometry": {
        "checks": {
          "body_count": {
            "expected": 1
          }
        }
      }
    }
  },
  "constraints": [
    {
      "expression": "case_thickness > wall * 4 + hub_height",
      "severity": "error",
      "message": {
        "en": "The case must clear the hub.",
        "es": "La caja debe dejar espacio para la retención."
      }
    },
    {
      "expression": "hinge_web < wall && hinge_web > 0.2",
      "severity": "error",
      "message": {
        "en": "The explanatory hinge skin must be thinner than the wall.",
        "es": "La piel de la bisagra debe ser más delgada que la pared."
      }
    },
    {
      "expression": "sleeve_recess < wall / 2",
      "severity": "error",
      "message": {
        "en": "The sleeve recess must leave a floor.",
        "es": "El rebaje debe dejar material de fondo."
      }
    },
    {
      "expression": "media_width + wall * 6 < case_width && media_height + wall * 6 < case_height",
      "severity": "error",
      "message": {
        "en": "Media pocket must fit.",
        "es": "El bolsillo debe caber en la caja."
      }
    }
  ],
