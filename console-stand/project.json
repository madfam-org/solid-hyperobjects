      {
        "id": "cradle_seat",
        "label": {
          "en": "Device cradle",
          "es": "Asiento de dispositivo"
        },
        "geometry_type": "surface",
        "compatible_with": [
          "slab-handheld"
        ]
      }
    ],
    "composition": {
      "description": {
        "en": "Shared support components, inlined at build.",
        "es": "Componentes de soporte compartidos, integrados al generar."
      }
    }
  },
  "export_formats": [
    "stl",
    "step",
    "glb",
    "3mf"
  ],
