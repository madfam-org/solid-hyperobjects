    "domain": "consumer-electronics",
    "commons_license": "CERN-OHL-W-2.0",
    "cdg_interfaces": [
      {
        "id": "device_envelope",
        "label": {
          "en": "Stand envelope",
          "es": "Envolvente del soporte"
        },
        "geometry_type": "profile",
        "compatible_with": [
          "rugged-box"
        ]
      },
      {
        "id": "stand_seat",
        "label": {
          "en": "Console/stand seat",
          "es": "Asiento de consola"
        },
        "geometry_type": "surface",
        "compatible_with": [
          "home-console"
        ]
