{
  "project": {
    "name": "Console Stand",
    "slug": "console-stand",
    "version": "0.1.0",
    "engine": "cadquery",
    "difficulty": "intermediate",
    "description": {
      "en": "Original circular base, console clip and cradle family with sourced stand body envelopes.",
      "es": "Familia original de base circular, clip y cuna con envolventes documentadas."
    },
    "thumbnail": "/projects/console-stand.webp",
    "tags": [
      "case",
      "media",
      "gaming",
      "hyperobject",
      "commons",
      "cdg"
    ],
