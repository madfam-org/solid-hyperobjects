      "engine": "cadquery",
      "parts": [
        "envelope"
      ],
      "estimate": {
        "base_time": 3,
        "per_part": 2
      }
    }
  ],
  "verification": {
    "stages": {
      "geometry": {
        "checks": {
          "body_count": {
            "expected": 1
          }
        }
      }
    }
  },
  "constraints": [
    {
      "expression": "base_height < body_height && wall * 2 < body_width",
      "severity": "error",
      "message": {
        "en": "Base and walls must fit the envelope.",
        "es": "La base y las paredes deben caber."
      }
    },
    {
      "expression": "seat_width + wall * 2 < body_width && seat_depth < body_depth",
      "severity": "error",
      "message": {
        "en": "Seat must fit the support footprint.",
        "es": "El asiento debe caber en la huella."
      }
    },
    {
      "expression": "mount_hole_diameter < seat_width / 2 && cable_slot_width < body_width / 3",
      "severity": "error",
      "message": {
        "en": "Holes must leave connected support material.",
        "es": "Los huecos deben dejar material unido."
      }
    },
    {
      "expression": "(body_height - base_height + wall) * 0.5774 < (body_depth + seat_depth) / 2",
      "severity": "error",
      "message": {
        "en": "Back support must remain inside the footprint at the minimum cradle angle.",
        "es": "El respaldo debe permanecer dentro de la huella al ángulo mínimo."
      }
    }
  ],
  "animations": [
    {
      "id": "cradle-tilt",
      "label": {
        "en": "Cradle angle",
        "es": "Ángulo de cuna"
      },
      "from_state": {
        "stand_kind": "cradle",
        "tilt_angle": 60
      },
      "to_state": {
        "stand_kind": "cradle",
        "tilt_angle": 80
      },
      "frames": 5,
      "duration_ms": 2000,
      "mode": "stand"
    }
  ],
  "camera_views": [
    {
      "id": "iso",
      "label": {
        "en": "Isometric",
        "es": "Isométrica"
      },
      "position": [
        200,
        -200,
        180
      ],
      "target": [
        0,
        0,
        10
      ]
    }
  ],
