  "constraints": [
    {
      "expression": "peg_d + 3 * screw_d + 14 <= base_l",
      "severity": "error",
      "message": {
        "en": "The plate is too short for the peg and a screw on each side of it",
        "es": "La placa es demasiado corta para la clavija y un tornillo a cada lado"
      }
    },
    {
      "expression": "peg_d + 8 <= base_w && screw_d + 8 <= base_w",
      "severity": "error",
      "message": {
        "en": "The plate must be at least 8 mm wider than the peg and than a screw hole",
        "es": "La placa debe ser al menos 8 mm más ancha que la clavija y que un barreno de tornillo"
      }
    },
    {
      "expression": "cord_d + 3 * screw_d + 15 <= block_w",
      "severity": "error",
      "message": {
        "en": "The block is too narrow for the channel and a screw on each side of it",
        "es": "El bloque es demasiado angosto para el canal y un tornillo a cada lado"
      }
    },
    {
      "expression": "cord_d * 0.75 + 6 <= block_h",
      "severity": "error",
      "message": {
        "en": "The block must leave at least 4 mm of solid under the blade slot",
        "es": "El bloque debe dejar al menos 4 mm macizos bajo la ranura de la navaja"
      }
    },
    {
      "expression": "4 * screw_d + 18 <= block_l",
      "severity": "error",
      "message": {
        "en": "The block is too short for its two screws and the blade slot between them",
        "es": "El bloque es demasiado corto para sus dos tornillos y la ranura de la navaja entre ellos"
      }
    },
    {
      "expression": "peg_h >= peg_d",
      "severity": "warning",
      "message": {
        "en": "A peg shorter than its own diameter lets a loop ride off the top",
        "es": "Una clavija más baja que su propio diámetro deja que una gaza se salga por arriba"
      }
    }
  ],
