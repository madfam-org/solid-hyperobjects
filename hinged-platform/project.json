  "constraints": [
    {
      "expression": "pin_d + 6 <= panel_t",
      "severity": "error",
      "message": {
        "en": "The panel must leave at least 3 mm of material round the hinge pin",
        "es": "El panel debe dejar al menos 3 mm de material alrededor del perno de bisagra"
      }
    },
    {
      "expression": "!lock || panel_t - pin_d >= 2 * lock_d + 6",
      "severity": "error",
      "message": {
        "en": "The lock hole does not fit between the pin and the surface of the barrel: use a thicker panel or thinner pins",
        "es": "El barreno del seguro no cabe entre el perno y la superficie del barril: usa un panel más grueso o pernos más delgados"
      }
    },
    {
      "expression": "block_inset >= block_w / 2 + 12",
      "severity": "error",
      "message": {
        "en": "The outer blocks must leave at least 12 mm of panel between their notch and the side edge",
        "es": "Los bloques exteriores deben dejar al menos 12 mm de panel entre su muesca y el borde lateral"
      }
    },
    {
      "expression": "panel_w - 2 * block_inset >= (blocks - 1) * (block_w + 26)",
      "severity": "error",
      "message": {
        "en": "The blocks do not fit along the hinge: the notches need at least 20 mm of panel between them",
        "es": "Los bloques no caben a lo largo de la bisagra: las muescas necesitan al menos 20 mm de panel entre ellas"
      }
    },
    {
      "expression": "panel_l >= skid_d + panel_t + 20",
      "severity": "error",
      "message": {
        "en": "The panel is too short for its skid and its hinge edge",
        "es": "El panel es demasiado corto para su patín y su borde de bisagra"
      }
    },
    {
      "expression": "axis_h >= flange_t + 4",
      "severity": "error",
      "message": {
        "en": "The hinge axis must stand at least 4 mm above the top of the flange",
        "es": "El eje de la bisagra debe quedar al menos 4 mm sobre la cara superior de la brida"
      }
    },
    {
      "expression": "flange_l >= panel_t / 2 + 2 * bolt_d + 4",
      "severity": "error",
      "message": {
        "en": "The flange must reach far enough behind the barrel for its bolts",
        "es": "La brida debe extenderse lo suficiente detrás del barril para sus tornillos"
      }
    },
    {
      "expression": "!lock || block_inset <= 150",
      "severity": "warning",
      "message": {
        "en": "The lock pin is pushed in from the side edge and has to reach the first block: over 150 mm it is hard to find one long enough",
        "es": "El perno del seguro entra por el borde lateral y debe llegar al primer bloque: a más de 150 mm es difícil conseguir uno tan largo"
      }
    },
    {
      "expression": "axis_h * 2 >= panel_t",
      "severity": "warning",
      "message": {
        "en": "The axis sits lower than half the panel thickness: the panel only lies flat if it overhangs the edge the block is bolted to",
        "es": "El eje queda más bajo que la mitad del espesor del panel: el panel solo queda plano si sobresale del borde donde se atornilla el bloque"
      }
    }
  ],
