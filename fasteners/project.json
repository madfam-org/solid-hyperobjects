{
  "project": {
    "name": "Fastener Generator",
    "slug": "fasteners",
    "version": "2.1.0",
    "attribution": {
      "author": "Innovaciones MADFAM",
      "license": "CERN-OHL-W-2.0"
    },
    "engine": "cadquery",
    "description": {
      "en": "Parametric ISO metric hardware — bolts, nuts and washers sized to mate real M-series fasteners. Major diameter equals the nominal (M5 = 5 mm), pitch is the real coarse-series value, and head/nut across-flats follow the ISO wrench envelope. Threads default to a fast cosmetic profile with an opt-in real helical thread.\n\nOfficial Visualizer and Configurator: Yantra4D",
      "es": "Tornillería métrica ISO paramétrica — tornillos, tuercas y arandelas dimensionadas para acoplar herrajes M reales. El diámetro mayor es el nominal (M5 = 5 mm), el paso es el valor real de serie gruesa y el entrecaras de cabeza/tuerca sigue el sobre de llave ISO. Las roscas usan por defecto un perfil cosmético rápido con rosca helicoidal real opcional.\n\nVisualizador y configurador oficial: Yantra4D"
    },
    "thumbnail": "/projects/fasteners.webp",
    "difficulty": "intermediate",
    "tags": [
      "fasteners",
      "hardware",
      "bolt",
      "nut",
      "washer",
      "thread",
      "iso-metric",
      "hyperobject",
      "commons",
      "fastener"
    ],
    "hyperobject": {
      "is_hyperobject": true
    },
    "force_backend": true
  },
