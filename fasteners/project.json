  "constraints": [
    {
      "expression": "pitch <= diameter",
      "severity": "error",
      "message": {
        "en": "Pitch must be less than diameter",
        "es": "El paso debe ser menor que el diámetro"
      }
    },
    {
      "expression": "length >= diameter",
      "severity": "warning",
      "message": {
        "en": "Length should be at least 1x diameter",
        "es": "El largo debe ser al menos 1x el diámetro"
      }
    }
