  "constraints": [
    {
      "expression": "sleeve_h >= ear_h + pin_d + 22",
      "severity": "error",
      "message": {
        "en": "The sleeve must be tall enough to stack the pin boss above the yoke",
        "es": "La camisa debe ser lo bastante alta para alojar el buje del perno arriba de la horquilla"
      }
    },
    {
      "expression": "pin_d + 12 <= column_w + 2 * slide_clr + 2 * sleeve_wall",
      "severity": "error",
      "message": {
        "en": "The pin boss cannot be wider than the sleeve",
        "es": "El buje del perno no puede ser más ancho que la camisa"
      }
    },
    {
      "expression": "yoke_gap + 2 * ear_t <= column_w + 2 * slide_clr + 2 * sleeve_wall",
      "severity": "error",
      "message": {
        "en": "The yoke cannot be wider than the sleeve",
        "es": "La horquilla no puede ser más ancha que la camisa"
      }
    },
    {
      "expression": "ear_h >= pivot_d + 12",
      "severity": "error",
      "message": {
        "en": "The ears must be at least as tall as the eye around the pivot bore",
        "es": "Las orejas deben ser al menos tan altas como el ojo alrededor del barreno de pivote"
      }
    },
    {
      "expression": "ear_reach >= pivot_d / 2 + 6",
      "severity": "error",
      "message": {
        "en": "The pivot must stand far enough out for its eye to clear the sleeve face",
        "es": "El pivote debe quedar lo bastante afuera para que su ojo libre la cara de la camisa"
      }
    },
    {
      "expression": "slide_clr >= 0.3",
      "severity": "warning",
      "message": {
        "en": "Under 0.3 mm per side a printed sleeve can bind on the column",
        "es": "Con menos de 0.3 mm por lado, una camisa impresa puede atorarse en la columna"
      }
    },
    {
      "expression": "sleeve_h >= column_d",
      "severity": "warning",
      "message": {
        "en": "A sleeve shorter than the column is deep tilts under an offset load and binds",
        "es": "Una camisa más corta que el fondo de la columna se ladea con carga excéntrica y se atora"
      }
    }
  ],
