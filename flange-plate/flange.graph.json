{
  "version": "1.1.0",
  "units": "mm",
  "meta": {
    "title": "Bolt-Circle Flange Plate",
    "notes": "Exercises the profile→extrude and pattern_polar vocabulary, and the expression dialect: the polar spacing is derived from the bolt count with {\"expr\": \"360 / bolt_count\"}, so an evenly spaced circle cannot be misconfigured. Before graph v1.1 the format had no expressions and the author had to set both by hand — that is what the bolt_spacing_deg slider was, and it is gone."
  },
  "nodes": [
    { "id": "outline", "type": "profile_circle", "params": { "r": 45 } },
    { "id": "plate", "type": "extrude", "inputs": { "profile": "outline" }, "params": { "height": 8 } },

    { "id": "bore", "type": "cylinder", "params": { "r": 12, "h": 400 } },
    { "id": "plate_bored", "type": "cut", "inputs": { "a": "plate", "b": "bore" } },

    { "id": "boltcut", "type": "cylinder", "params": { "r": 4.25, "h": 400 } },
    { "id": "boltpos", "type": "translate", "inputs": { "shape": "boltcut" }, "params": { "x": 32 } },
    { "id": "boltring", "type": "pattern_polar", "inputs": { "shape": "boltpos" }, "params": { "count": 6, "angle": { "expr": "360 / bolt_count" } } },

    { "id": "drilled", "type": "cut", "inputs": { "a": "plate_bored", "b": "boltring" } },
    { "id": "flange", "type": "chamfer", "inputs": { "shape": "drilled" }, "params": { "edges": ">Z", "distance": 0.8 } },

    { "id": "blank", "type": "chamfer", "inputs": { "shape": "plate_bored" }, "params": { "edges": ">Z", "distance": 0.8 } }
  ],
  "outputs": {
    "flange": "flange",
    "blank": "blank"
  }
}
