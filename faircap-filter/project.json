        "cap",
        "housing",
        "membrane_holder"
      ],
      "label": {
        "en": "Thread Clearance (mm)",
        "es": "Holgura de Rosca (mm)"
      },
      "tooltip": {
        "en": "Per-side gap added to the female PCO-1881 thread so it screws onto the bottle despite print tolerances (0.3-0.5 typical)",
        "es": "Espacio por lado añadido a la rosca hembra PCO-1881 para que enrosque en la botella pese a las tolerancias de impresión (0.3-0.5 típico)"
      }
    },
