      ],
      "advanced": true,
      "label": {
        "en": "Filter Seat Lip (mm)",
        "es": "Reborde del Asiento (mm)"
      },
      "tooltip": {
        "en": "Width of the internal ledge that retains the filter medium in the cap",
        "es": "Ancho de la repisa interna que retiene el medio filtrante en la tapa"
      }
    },
    {
