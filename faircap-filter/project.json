        "es": "Tipo de Medio Filtrante"
      },
      "tooltip": {
        "en": "Filter medium the housing is built for: activated charcoal, a hollow-fiber membrane, or a ceramic disc. Sets the retaining-grille spacing and the disc-holder standoff.",
        "es": "Medio filtrante para el que se construye la carcasa: carbón activado, membrana de fibra hueca o disco cerámico. Ajusta el espaciado de la rejilla de retención y el soporte del disco."
      },
      "options": [
        {
          "value": "charcoal",
          "label": {
            "en": "Activated Charcoal — granular adsorption",
            "es": "Carbón Activado — adsorción granular"
          }
        },
        {
          "value": "membrane",
