      "gaming",
      "handheld",
      "parametric",
      "hyperobject",
      "commons",
      "cdg"
    ],
    "slug": "slab-handheld",
    "version": "0.1.0",
    "difficulty": "intermediate",
    "attribution": {
      "author": "Innovaciones MADFAM",
      "license": "CERN-OHL-W-2.0"
    }
  },
