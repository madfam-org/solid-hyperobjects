  "verification": {
    "stages": {
      "geometry": {
        "checks": {
          "body_count": {
            "expected": 1
          }
        }
      }
    },
    "mode_overrides": {
      "device": {
        "part_overrides": {
          "rear_body": {
            "geometry.body_count": {
              "expected": "1 if media_kind == 'none' else 2"
            }
          }
        }
      },
      "rear_body": {
        "part_overrides": {
          "rear_body": {
            "geometry.body_count": {
              "expected": "1 if media_kind == 'none' else 2"
            }
          }
        }
      }
    }
  },
  "constraints": [
    {
      "expression": "body_depth > wall * 3",
      "severity": "error",
      "message": {
        "en": "Depth must leave room for two walls.",
        "es": "El fondo debe admitir dos paredes."
      }
    },
    {
      "expression": "screen_width < body_width - wall * 2 && screen_height < body_height - wall * 2",
      "severity": "error",
      "message": {
        "en": "Display must fit the body.",
        "es": "La pantalla debe caber en el cuerpo."
      }
    },
    {
      "expression": "bay_width + 6 < body_width && bay_height + 6 < body_height",
      "severity": "error",
      "message": {
        "en": "Battery door must fit the rear.",
        "es": "La tapa debe caber en la parte trasera."
      }
    },
    {
