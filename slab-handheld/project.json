    "description": {
      "en": "Original slab handheld family with sourced presets, display and control seats, media, battery bay and attachment interfaces.",
      "es": "Familia portátil plana original con presets documentados, pantalla, controles, medios, batería e interfaces."
    },
    "license": "CERN-OHL-W-2.0",
    "thumbnail": "/projects/slab-handheld.webp",
